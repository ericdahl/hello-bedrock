# LangFuse Configuration
# Copy this file to .env and fill in your credentials

# Get your API keys from https://cloud.langfuse.com
# Navigate to Settings > API Keys to create new keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# LangFuse Host URL
# For cloud: https://cloud.langfuse.com (default)
# For self-hosted: use your own URL (e.g., http://localhost:3000)
LANGFUSE_HOST=https://cloud.langfuse.com

# AWS Credentials (if not using AWS CLI profile)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
